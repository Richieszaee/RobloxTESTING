--// WEBHOOK FUNCTION
local function sendWebhook(embed)
	if not getgenv().webhookUrl or getgenv().webhookUrl == "" then
		setStatus("❌ Webhook URL kosong!", Color3.fromRGB(255, 80, 80))
		return false
	end
	local body = HttpService:JSONEncode({
		content = "",
		embeds = {embed}
	})
	local req = http_request or request or (syn and syn.request) or (fluxus and fluxus.request) or (http and http.request)
	if not req then
		setStatus("❌ Executor tidak support HttpPost", Color3.fromRGB(255, 80, 80))
		return false
	end
	local ok = pcall(function()
		req({
			Url = getgenv().webhookUrl,
			Method = "POST",
			Headers = {["content-type"] = "application/json"},
			Body = body
		})
	end)
	if ok then
		setStatus("✅ Terkirim ke Discord", Color3.fromRGB(0, 255, 0))
	else
		setStatus("❌ Gagal kirim webhook", Color3.fromRGB(255, 80, 80))
	end
	return ok
end

