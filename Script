	lang = "",
	charset = "",
	ogTitle = "",
	ogDesc = "",
	ogImage = "",
	ogUrl = "",
	ogType = "",
	ogSite = "",
	twCard = "",
	twTitle = "",
	twDesc = "",
	twImage = "",
	links = {},
	images = {},
	scripts = {},
	styles = {},
	forms = 0,
	h1 = 0, h2 = 0, h3 = 0,
	paragraphs = 0,
	hasViewport = false,
	hasFavicon = false,
	hasCanonical = false,
	hasRobots = false,
	isHttps = false,
	server = "",
	contentType = "",
	inlineScripts = 0,
	inlineStyles = 0,
	externalDomains = {},
}

-- Parser
local function analyzeHTML(url, html)
	local a = Analysis
	a.url = url
	a.html = html
	a.bytes = #html
	a.isHttps = url:sub(1, 6) == "https:"

	a.title = html:match("<title[^>]*>([^<]*)</title>") or ""
	a.desc = getMeta(html, "name", "description") or ""
	a.keywords = getMeta(html, "name", "keywords") or ""
	a.author = getMeta(html, "name", "author") or ""
	a.lang = html:match('<html[^>]*lang="([^"]*)"') or ""
	a.charset = html:match('<meta[^>]*charset="([^"]*)"') or html:match('charset=([%w%-]+)') or ""

	a.ogTitle = getMeta(html, "property", "og:title") or ""
	a.ogDesc = getMeta(html, "property", "og:description") or ""
	a.ogImage = getMeta(html, "property", "og:image") or ""
	a.ogUrl = getMeta(html, "property", "og:url") or ""
	a.ogType = getMeta(html, "property", "og:type") or ""
	a.ogSite = getMeta(html, "property", "og:site_name") or ""

	a.twCard = getMeta(html, "name", "twitter:card") or ""
	a.twTitle = getMeta(html, "name", "twitter:title") or ""
	a.twDesc = getMeta(html, "name", "twitter:description") or ""
	a.twImage = getMeta(html, "name", "twitter:image") or ""

	a.links = collectMatches(html, '<a[^>]*href="([^"]*)"')
	a.images = collectMatches(html, '<img[^>]*src="([^"]*)"')
	a.scripts = collectMatches(html, '<script[^>]*src="([^"]*)"')
	a.styles = collectMatches(html, '<link[^>]*rel="stylesheet"[^>]*href="([^"]*)"')

	a.forms = countMatches(html, "<form")
	a.h1 = countMatches(html, "<h1")
	a.h2 = countMatches(html, "<h2")
	a.h3 = countMatches(html, "<h3")
	a.paragraphs = countMatches(html, "<p[ >]")
	a.inlineScripts = countMatches(html, "<script[^>]*>") - #a.scripts
	a.inlineStyles = countMatches(html, "<style[^>]*>")

	a.hasViewport = html:find('name="viewport"', 1, true) ~= nil
	a.hasFavicon = html:find('rel="icon"', 1, true) ~= nil or html:find('rel="shortcut icon"', 1, true) ~= nil
	a.hasCanonical = html:find('rel="canonical"', 1, true) ~= nil
	a.hasRobots = html:find('name="robots"', 1, true) ~= nil

	-- Extract server headers (bisa dari comment atau meta)
	a.server = html:match("Server: ([^\r\n]+)") or "-"
	a.contentType = html:match("Content%-Type: ([^\r\n]+)") or "-"

	-- Domains
	local domains = {}
	for _, link in ipairs(a.links) do
		local d = link:match("^https?://([^/]+)")
		if d and not d:find(url:match("^https?://([^/]+)") or "", 1, true) then
			domains[d] = true
		end
	end
	for d in pairs(domains) do table.insert(a.externalDomains, d) end
	table.sort(a.externalDomains)
end

-- Render per tab
function renderTab(name)
	clearContent()

	if not Analysis.html or Analysis.html == "" then
		addLine("Belum ada data. Fetch URL dulu.", Color3.fromRGB(255, 180, 0))
		return
	end

	local a = Analysis

	if name == "📋 Info" then
		addHeader("📋 PAGE OVERVIEW")
		addKeyValue("URL", a.url, Color3.fromRGB(0, 220, 255))
		addKeyValue("HTTPS", a.isHttps and "✅ Ya" or "❌ Tidak", a.isHttps and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 100, 100))
		addKeyValue("Size", a.bytes .. " bytes (" .. string.format("%.2f", a.bytes/1024) .. " KB)")
		addKeyValue("Title", a.title ~= "" and a.title or "(kosong)", a.title ~= "" and Color3.fromRGB(230,230,230) or Color3.fromRGB(255,100,100))
		addKeyValue("Description", a.desc ~= "" and a.desc or "(kosong)", a.desc ~= "" and Color3.fromRGB(200,200,200) or Color3.fromRGB(255,100,100))
		addKeyValue("Lang", a.lang ~= "" and a.lang or "(tidak set)")
		addKeyValue("Charset", a.charset ~= "" and a.charset or "(tidak set)")

		addHeader("📐 STRUKTUR")
		addKeyValue("H1", a.h1, a.h1 == 1 and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,200,0))
		addKeyValue("H2", a.h2)
		addKeyValue("H3", a.h3)
		addKeyValue("Paragraphs", a.paragraphs)
		addKeyValue("Forms", a.forms)
		addKeyValue("Links", #a.links)
		addKeyValue("Images", #a.images)
		addKeyValue("Scripts (external)", #a.scripts)
		addKeyValue("Scripts (inline)", a.inlineScripts)
		addKeyValue("Stylesheets", #a.styles)

	elseif name == "🏷️ Meta" then
		addHeader("📌 BASIC META")
		addKeyValue("Title", a.title ~= "" and a.title or "(kosong)")
		addKeyValue("Description", a.desc ~= "" and a.desc or "(kosong)")
		addKeyValue("Keywords", a.keywords ~= "" and a.keywords or "(kosong)")
		addKeyValue("Author", a.author ~= "" and a.author or "(kosong)")

		addHeader("🌐 OPEN GRAPH")
		addKeyValue("og:title", a.ogTitle ~= "" and a.ogTitle or "(kosong)")
		addKeyValue("og:description", a.ogDesc ~= "" and a.ogDesc or "(kosong)")
		addKeyValue("og:type", a.ogType ~= "" and a.ogType or "(kosong)")
		addKeyValue("og:url", a.ogUrl ~= "" and a.ogUrl or "(kosong)")
		addKeyValue("og:image", a.ogImage ~= "" and a.ogImage or "(kosong)")
		addKeyValue("og:site_name", a.ogSite ~= "" and a.ogSite or "(kosong)")

		addHeader("🐦 TWITTER CARD")
		addKeyValue("twitter:card", a.twCard ~= "" and a.twCard or "(kosong)")
		addKeyValue("twitter:title", a.twTitle ~= "" and a.twTitle or "(kosong)")
		addKeyValue("twitter:description", a.twDesc ~= "" and a.twDesc or "(kosong)")
		addKeyValue("twitter:image", a.twImage ~= "" and a.twImage or "(kosong)")

	elseif name == "🔗 Links" then
		addHeader("🔗 LINKS (" .. #a.links .. ")")
		if #a.links == 0 then addLine("  (tidak ada link)", Color3.fromRGB(150,150,150)) end
		for i = 1, math.min(80, #a.links) do
			local link = a.links[i]
			local color = link:match("^https?://") and Color3.fromRGB(0,220,255) or Color3.fromRGB(200,200,200)
			addLine("  " .. i .. ". " .. link, color)
		end
		if #a.links > 80 then addLine("  ... +" .. (#a.links - 80) .. " link lagi", Color3.fromRGB(150,150,150)) end

		addHeader("🌍 DOMAIN EKSTERNAL (" .. #a.externalDomains .. ")")
		for _, d in ipairs(a.externalDomains) do
			addLine("  • " .. d, Color3.fromRGB(255, 200, 0))
		end

	elseif name == "🖼️ Images" then
		addHeader("🖼️ IMAGES (" .. #a.images .. ")")
		if #a.images == 0 then addLine("  (tidak ada image)", Color3.fromRGB(150,150,150)) end
		for i = 1, math.min(60, #a.images) do
			addLine("  " .. i .. ". " .. a.images[i], Color3.fromRGB(200, 180, 255))
		end
		if #a.images > 60 then addLine("  ... +" .. (#a.images - 60) .. " image lagi", Color3.fromRGB(150,150,150)) end

		addHeader("📜 SCRIPTS (" .. #a.scripts .. ")")
		for i = 1, math.min(40, #a.scripts) do
			addLine("  " .. i .. ". " .. a.scripts[i], Color3.fromRGB(255, 180, 100))
		end

		addHeader("🎨 STYLESHEETS (" .. #a.styles .. ")")
		for i = 1, math.min(30, #a.styles) do
			addLine("  " .. i .. ". " .. a.styles[i], Color3.fromRGB(100, 220, 180))
		end

	elseif name == "🔒 Security" then
		addHeader("🔒 SECURITY CHECK")
		addKeyValue("HTTPS", a.isHttps and "✅ Ya" or "❌ Tidak", a.isHttps and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,100,100))
		addKeyValue("Viewport meta", a.hasViewport and "✅ Ada" or "❌ Tidak", a.hasViewport and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,200,0))
		addKeyValue("Favicon", a.hasFavicon and "✅ Ada" or "❌ Tidak", a.hasFavicon and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,200,0))
		addKeyValue("Canonical URL", a.hasCanonical and "✅ Ada" or "❌ Tidak", a.hasCanonical and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,200,0))
		addKeyValue("Robots meta", a.hasRobots and "✅ Ada" or "❌ Tidak")
		addKeyValue("Server Header", a.server)
		addKeyValue("Content-Type", a.contentType)

		addHeader("⚠️ WARNING")
		local warns = 0
		if not a.isHttps then addLine("  ⚠️ Situs tidak pakai HTTPS!", Color3.fromRGB(255,100,100)); warns = warns + 1 end
		if not a.hasViewport then addLine("  ⚠️ Tidak ada viewport meta (jelek di mobile)", Color3.fromRGB(255,200,0)); warns = warns + 1 end
		if a.title == "" then addLine("  ⚠️ Tidak ada title tag", Color3.fromRGB(255,200,0)); warns = warns + 1 end
		if a.desc == "" then addLine("  ⚠️ Tidak ada meta description", Color3.fromRGB(255,200,0)); warns = warns + 1 end
		if a.h1 == 0 then addLine("  ⚠️ Tidak ada tag H1", Color3.fromRGB(255,200,0)); warns = warns + 1 end
		if a.h1 > 1 then addLine("  ⚠️ Ada " .. a.h1 .. " tag H1 (sebaiknya 1)", Color3.fromRGB(255,200,0)); warns = warns + 1 end
		if warns == 0 then addLine("  ✅ Tidak ada warning", Color3.fromRGB(0,255,100)) end

	elseif name == "📜 Raw" then
		addHeader("📜 RAW HTML (" .. a.bytes .. " bytes)")
		local preview = a.html:sub(1, 8000)
		addLine(preview, Color3.fromRGB(180,180,180))
		if a.bytes > 8000 then
			addLine("... [dipotong, " .. (a.bytes - 8000) .. " bytes lagi]", Color3.fromRGB(255,200,0))
		end
	end
end

-- Main fetch
local function fetchAndAnalyze(url)
	if url == "" then
		Status.Text = "❌ URL kosong!"
		Status.TextColor3 = Color3.fromRGB(255, 100, 100)
		return
	end
	if not url:match("^https?://") then
		url = "https://" .. url
		UrlBox.Text = url
	end

	Status.Text = "⏳ Fetching " .. url:sub(1, 60) .. "..."
	Status.TextColor3 = Color3.fromRGB(255, 200, 0)
	clearContent()
	addLine("⏳ Sedang fetch...", Color3.fromRGB(255, 200, 0))

	task.spawn(function()
		local ok, html = pcall(function()
			return game:HttpGet(url, true)
		end)

		if not ok or not html or html == "" then
			Status.Text = "❌ Gagal fetch (error/timeout)"
			Status.TextColor3 = Color3.fromRGB(255, 100, 100)
			clearContent()
			addLine("❌ Gagal fetch URL ini.", Color3.fromRGB(255, 100, 100))
			addLine("Error: " .. tostring(html), Color3.fromRGB(255, 150, 150))
			return
		end

		analyzeHTML(url, html)

		Status.Text = string.format("✅ %s — %d bytes", url:sub(1, 50), #html)
		Status.TextColor3 = Color3.fromRGB(0, 255, 120)

		-- Auto switch ke Info
		if activeTab then
			renderTab(activeTab)
		else
			renderTab("📋 Info")
		end
	end)
end

