end

--// HTML Helpers
local function stripTags(html)
	local txt = html
	txt = txt:gsub("<script[^>]*>.-</script>", "")
	txt = txt:gsub("<style[^>]*>.-</style>", "")
	txt = txt:gsub("<[^>]->", " ")
	txt = txt:gsub("&nbsp;", " ")
	txt = txt:gsub("&amp;", "&")
	txt = txt:gsub("&lt;", "<")
	txt = txt:gsub("&gt;", ">")
	txt = txt:gsub("&quot;", '"')
	txt = txt:gsub("&#39;", "'")
	txt = txt:gsub("%s+", " ")
	return txt
end

local function extractMeta(html, prop)
	-- Cari <meta property="prop" content="...">
	local pattern = '<meta[^>]*property="' .. prop .. '"[^>]*content="([^"]*)"'
	local val = html:match(pattern)
	if not val then
		-- Coba urutan terbalik
		pattern = '<meta[^>]*content="([^"]*)"[^>]*property="' .. prop .. '"'
		val = html:match(pattern)
	end
	return val
end

local function extractName(html, name)
	local pattern = '<meta[^>]*name="' .. name .. '"[^>]*content="([^"]*)"'
	local val = html:match(pattern)
	if not val then
		pattern = '<meta[^>]*content="([^"]*)"[^>]*name="' .. name .. '"'
		val = html:match(pattern)
	end
	return val
end

--// FETCH FUNCTION
local function fetchWebsite(url)
	if url == "" or not url:match("^https?://") then
		setStatus("❌ URL harus mulai dengan http:// atau https://", Color3.fromRGB(255, 80, 80))
		return
	end

	setStatus("⏳ Fetching... " .. url:sub(1, 40), Color3.fromRGB(255, 200, 0))
	clearOutput()

	local ok, html = pcall(function()
		return game:HttpGet(url, true)
	end)

	if not ok or not html then
		setStatus("❌ Gagal fetch (HttpGet error)", Color3.fromRGB(255, 80, 80))
		addBlock("❌ Error: " .. tostring(html), Color3.fromRGB(255, 100, 100))
		return
	end

	addBlock("✅ Berhasil fetch (" .. #html .. " bytes)", Color3.fromRGB(0, 255, 120))

	-- Extract info
	local title = html:match("<title[^>]*>([^<]*)</title>") or "No title"
	local desc = extractName(html, "description") or extractMeta(html, "og:description") or "-"
	local ogTitle = extractMeta(html, "og:title") or "-"
	local ogImage = extractMeta(html, "og:image") or "-"
	local ogUrl = extractMeta(html, "og:url") or "-"
	local ogType = extractMeta(html, "og:type") or "-"

	addBlock("━━━ 📄 PAGE INFO ━━━", Color3.fromRGB(0, 200, 255))
	addBlock("📌 Title: " .. title, Color3.fromRGB(255, 255, 255))
	addBlock("📝 Description: " .. desc, Color3.fromRGB(200, 200, 200))

	addBlock("━━━ 🌐 OPEN GRAPH ━━━", Color3.fromRGB(0, 200, 255))
	addBlock("OG Title: " .. ogTitle, Color3.fromRGB(200, 220, 255))
	addBlock("OG Type: " .. ogType, Color3.fromRGB(200, 220, 255))
	addBlock("OG URL: " .. ogUrl, Color3.fromRGB(200, 220, 255))
	addBlock("OG Image: " .. ogImage, Color3.fromRGB(200, 220, 255))

	-- Reader mode
	if ReaderMode then
		addBlock("━━━ 📖 READER MODE ━━━", Color3.fromRGB(0, 255, 120))
		local plain = stripTags(html)
		-- Potong biar nggak kepanjangan
		if #plain > 3000 then plain = plain:sub(1, 3000) .. "... [dipotong]" end
		addBlock(plain, Color3.fromRGB(220, 220, 220))
	else
		-- Raw preview
		addBlock("━━━ 📜 RAW HTML (preview) ━━━", Color3.fromRGB(255, 200, 0))
		local preview = html:sub(1, 1500)
		addBlock(preview, Color3.fromRGB(180, 180, 180))
	end

	setStatus("✅ Selesai! " .. #html .. " bytes", Color3.fromRGB(0, 255, 120))
end

