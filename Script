-- ServerScriptService > WarpTweenSystem
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Points = {} -- nyimpen posisi tiap player [player.UserId] = {A = CFrame, B = CFrame}

local TWEEN_SPEED = 200 -- stud per detik. makin gede makin cepet

-- Remote buat komunikasi tool ke server
local Remote = Instance.new("RemoteEvent")
Remote.Name = "WarpRemote"
Remote.Parent = ReplicatedStorage

Remote.OnServerEvent:Connect(function(player, action)
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	Points[player.UserId] = Points[player.UserId] or {}
	
	if action == "SetA" then
		Points[player.UserId].A = hrp.CFrame
		player:Kick() -- hapus ini kalau mau notif biasa aja
		print(player.Name.." set Point A")
		
	elseif action == "SetB" then
		Points[player.UserId].B = hrp.CFrame
		print(player.Name.." set Point B")
		
	elseif action == "WarpToA" then
		if Points[player.UserId].A then
			local target = Points[player.UserId].A
			local dist = (hrp.Position - target.Position).Magnitude
			local time = dist / TWEEN_SPEED
			local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = target})
			tween:Play()
		end
		
	elseif action == "WarpToB" then
		if Points[player.UserId].B then
			local target = Points[player.UserId].B
			local dist = (hrp.Position - target.Position).Magnitude
			local time = dist / TWEEN_SPEED
			local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = target})
			tween:Play()
		end
	end
end)
