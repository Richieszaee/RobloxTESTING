-- LOGIC
local InteractRemote = RS2:FindFirstChild("Interact") or RS2:FindFirstChild("PickUp")

local function TweenTo(pos)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return 0 end
	local dist = (hrp.Position - pos.Position).Magnitude
	local time = math.clamp(dist / CFG.TweenSpeed, 0.05, 2)
	TS:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = pos}):Play()
	return time
end

local function FindEgg()
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local closest, dist = nil, math.huge
	for _,v in pairs(WS:GetDescendants()) do
		if v.Name:lower():find("egg") and v:IsA("BasePart") then
			local d = (hrp.Position - v.Position).Magnitude
			if d < dist then closest = v dist = d end
		end
	end
	return closest
end

task.spawn(function()
	while true do task.wait(0.08)
		if CFG.AutoSteal then
			local egg = FindEgg()
			if egg then
				local t1 = TweenTo(egg) task.wait(t1 + 0.05)
				if InteractRemote then InteractRemote:FireServer(egg) end
				task.wait(0.1)
				if CFG.BasePoint then local t2 = TweenTo(CFG.BasePoint) task.wait(t2 + 0.1) end
			end
		end
	end
end)

