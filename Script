--// ============ CHAT MONITOR ============
local function hookTextChat()
	local TC = game:GetService("TextChatService")
	if TC.ChatVersion == Enum.ChatVersion.TextChatService then
		TC.MessageReceived:Connect(function(msg)
			if not getgenv().LogChat then return end
			local sender = msg.TextSource and msg.TextSource.Name or "Unknown"
			local uid = msg.TextSource and msg.TextSource.UserId or 0
			local text = msg.Text or ""
			sendWebhook({
				title = "📨 Chat Message",
				color = 0x3498db,
				fields = {
					{name = "👤 Sender", value = "`" .. sender .. "`", inline = true},
					{name = "🆔 UserID", value = "`" .. tostring(uid) .. "`", inline = true},
					{name = "💬 Message", value = "```" .. text .. "```", inline = false}
				},
				footer = footer()
			})
		end)
	end
end

local function hookLegacyChat()
	local RP = game:GetService("ReplicatedStorage")
	local d = RP:FindFirstChild("DefaultChatSystemChatEvents")
	if d then
		local om = d:FindFirstChild("OnMessageDoneFiltering")
		if om then
			om.OnClientEvent:Connect(function(data)
				if not getgenv().LogChat then return end
				sendWebhook({
					title = "📨 Chat Message",
					color = 0x3498db,
					fields = {
						{name = "👤 Sender", value = "`" .. tostring(data.FromSpeaker) .. "`", inline = true},
						{name = "💬 Message", value = "```" .. tostring(data.Message) .. "```", inline = false}
					},
					footer = footer()
				})
			end)
		end
	end
end

pcall(hookTextChat)
pcall(hookLegacyChat)

