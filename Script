-- SPEED LABEL
local speedLabel = Instance.new("TextLabel", Main)
speedLabel.Size = UDim2.new(1,-20,0,15)
speedLabel.Position = UDim2.new(0,10,0,32)
speedLabel.Text = "Speed: "..TweenSpeed.." | Scroll Mouse"
speedLabel.TextColor3 = Color3.fromRGB(200,200,200)
speedLabel.Font = Enum.Font.Gotham
speedLabel.TextSize = 10
speedLabel.BackgroundTransparency = 1

-- FUNCTION
local function TweenTo(pos)
	if CurrentTween then CurrentTween:Cancel() end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local dist = (hrp.Position - pos.Position).Magnitude
	local time = math.clamp(dist / TweenSpeed, 0.1, 3)
	CurrentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = pos})
	CurrentTween:Play()
end

local function MakeBtn(name, y, cb)
    local b = Instance.new("TextButton", Main)
    b.Size = UDim2.new(1,-20,0,30)
    b.Position = UDim2.new(0,10,0,y)
    b.Text = name
    b.BackgroundColor3 = Color3.fromRGB(25,25,35)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
    b.MouseButton1Click:Connect(cb)
end

-- TOMBOL 1
MakeBtn("SET BASE", 55, function()
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if hrp then BasePoint = hrp.CFrame + Vector3.new(0,3,0) end
end)

-- TOMBOL 2
MakeBtn("WARP TO BASE", 88, function()
	if BasePoint then TweenTo(BasePoint) end
end)

-- TOMBOL 3
local playerList = Players:GetPlayers()
local pIndex = 1
if #playerList > 0 then TargetPlayer = playerList[1] end

MakeBtn("WARP TO: "..(TargetPlayer and TargetPlayer.Name or "None"), 121, function()
	pIndex = pIndex % #playerList + 1
	TargetPlayer = playerList[pIndex]
	
	if TargetPlayer and TargetPlayer.Character then
		local hrp = TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
		if hrp then TweenTo(hrp) end
	end
end)

-- CLOSE
local closeBtn = Instance.new("TextButton", Main)
closeBtn.Size = UDim2.new(0,20,0,20)
closeBtn.Position = UDim2.new(1,-25,0,5)
