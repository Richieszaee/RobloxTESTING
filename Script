local function safeClick()
	if not CLICK_SUPPORTED then return false end
	local ok = pcall(function()
		if HAS_MOUSE1CLICK then
			mouse1click()
		elseif HAS_MOUSE_PRESS then
			mouse1press()
			task.wait(0.03)
