-- Speed slider
local function makeSlider(parent, x, w, name, min, max, default, callback)
	local box = Instance.new("Frame")
	box.Parent = parent
	box.Position = UDim2.new(0, x, 0, 5)
	box.Size = UDim2.new(0, w, 0, 36)
	box.BackgroundColor3 = C.surface2
	box.BorderSizePixel = 0
	corner(box, 8)

	local lbl = Instance.new("TextLabel")
	lbl.Parent = box
	lbl.Position = UDim2.new(0, 8, 0, 2)
	lbl.Size = UDim2.new(1, -16, 0, 14)
	lbl.BackgroundTransparency = 1
	lbl.Text = name .. ": " .. default
	lbl.TextColor3 = C.textDim
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left

	local bar = Instance.new("Frame")
	bar.Parent = box
	bar.Position = UDim2.new(0, 8, 0, 22)
	bar.Size = UDim2.new(1, -16, 0, 6)
	bar.BackgroundColor3 = C.bg
	bar.BorderSizePixel = 0
	corner(bar, 3)

	local fill = Instance.new("Frame")
	fill.Parent = bar
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = C.accent
	fill.BorderSizePixel = 0
	corner(fill, 3)

	local hit = Instance.new("TextButton")
	hit.Parent = box
	hit.Position = UDim2.new(0, 0, 0, 0)
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""

	local dragging = false
	local function update(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * rel)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		lbl.Text = name .. ": " .. v
		callback(v)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; update(i)
		end
	end)
	hit.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			update(i)
		end
	end)
end

