-- Player list render
local function isBlocked(plr)
	return getgenv().Blocklist[plr.UserId] == true
end

local function refreshPlayerList()
	for _, c in ipairs(ListScroll:GetChildren()) do
		if c:IsA("TextButton") or c:IsA("Frame") then c:Destroy() end
	end

	local blockedCount = 0
	for _ in pairs(getgenv().Blocklist) do blockedCount = blockedCount + 1 end
	BlockCountLbl.Text = "Blocklist: " .. blockedCount .. " player"

	local allPlayers = Players:GetPlayers()
	table.sort(allPlayers, function(a, b) return a.Name:lower() < b.Name:lower() end)

	for _, plr in ipairs(allPlayers) do
		if plr == LP then continue end

		local blocked = isBlocked(plr)
		local row = Instance.new("TextButton")
		row.Parent = ListScroll
		row.Size = UDim2.new(1, -4, 0, 34)
		row.BackgroundColor3 = blocked and Color3.fromRGB(60, 25, 35) or C.surface2
		row.BorderSizePixel = 0
		row.Text = ""
		row.AutoButtonColor = false
		corner(row, 8)
		stroke(row, blocked and C.danger or C.stroke, 1)

		local dot = Instance.new("Frame")
		dot.Parent = row
		dot.Size = UDim2.new(0, 8, 0, 8)
		dot.Position = UDim2.new(0, 14, 0.5, -4)
		dot.BackgroundColor3 = blocked and C.danger or C.success
		dot.BorderSizePixel = 0
		corner(dot, 4)

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Parent = row
		nameLbl.Position = UDim2.new(0, 30, 0, 0)
		nameLbl.Size = UDim2.new(1, -110, 1, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = plr.Name .. "  (@" .. plr.DisplayName .. ")"
		nameLbl.TextColor3 = blocked and C.danger or C.text
		nameLbl.Font = Enum.Font.GothamMedium
		nameLbl.TextSize = 12
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

		local tagLbl = Instance.new("TextLabel")
		tagLbl.Parent = row
		tagLbl.Position = UDim2.new(1, -90, 0, 0)
		tagLbl.Size = UDim2.new(0, 80, 1, 0)
		tagLbl.BackgroundTransparency = 1
		tagLbl.Text = blocked and "BLOCKED" or "click to block"
		tagLbl.TextColor3 = blocked and C.danger or C.textMuted
		tagLbl.Font = Enum.Font.Gotham
		tagLbl.TextSize = 10
		tagLbl.TextXAlignment = Enum.TextXAlignment.Right

		row.MouseButton1Click:Connect(function()
			if isBlocked(plr) then
				getgenv().Blocklist[plr.UserId] = nil
				log("Unblocked: " .. plr.Name, C.success)
			else
				getgenv().Blocklist[plr.UserId] = true
				log("Blocked: " .. plr.Name, C.danger)
				-- Kalau lagi follow player ini, hentikan
				if getgenv().CurrentTarget == plr then
					if getgenv().ActiveTween then
						pcall(function() getgenv().ActiveTween:Cancel() end)
					end
					getgenv().CurrentTarget = nil
				end
			end
			refreshPlayerList()
		end)

		row.MouseEnter:Connect(function()
			TweenService:Create(row, TweenInfo.new(0.12), {BackgroundColor3 = blocked and Color3.fromRGB(80, 30, 40) or Color3.fromRGB(40, 40, 55)}):Play()
		end)
		row.MouseLeave:Connect(function()
			TweenService:Create(row, TweenInfo.new(0.12), {BackgroundColor3 = blocked and Color3.fromRGB(60, 25, 35) or C.surface2}):Play()
		end)
	end
end

