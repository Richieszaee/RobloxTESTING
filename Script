--// CORE: get target & tween
local function getHRP()
	if not LP.Character then return nil end
	return LP.Character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	if not LP.Character then return nil end
	return LP.Character:FindFirstChildOfClass("Humanoid")
end

local function stopTween()
	if getgenv().ActiveTween then
		pcall(function() getgenv().ActiveTween:Cancel() end)
		getgenv().ActiveTween = nil
	end
	local hum = getHumanoid()
	if hum then
		hum.PlatformStand = false
	end
	local hrp = getHRP()
	if hrp then
		hrp.Anchored = false
	end
end

-- Cari player valid berikutnya (skip blocked & LP, skip yg ga ada char)
local function pickNextTarget()
	local myHRP = getHRP()
	if not myHRP then return nil end

	local candidates = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and not isBlocked(plr) then
			local char = plr.Character
			if char then
				local hrp = char:FindFirstChild("HumanoidRootPart")
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local dist = (myHRP.Position - hrp.Position).Magnitude
					table.insert(candidates, {plr = plr, hrp = hrp, dist = dist})
				end
			end
		end
	end
	table.sort(candidates, function(a, b) return a.dist < b.dist end)
	return candidates[1]
end

-- Tween ke target
local function tweenToTarget(targetInfo, onArrive)
	local myHRP = getHRP()
	local hum = getHumanoid()
	if not myHRP or not hum then return end

	local distance = (myHRP.Position - targetInfo.hrp.Position).Magnitude
	local duration = distance / getgenv().FollowSpeed
	if duration < 0.1 then duration = 0.1 end

	hum.PlatformStand = true
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	myHRP.Anchored = true

	local tween = TweenService:Create(
		myHRP,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{CFrame = CFrame.new(targetInfo.hrp.Position)}
	)
	getgenv().ActiveTween = tween
	tween:Play()
	tween.Completed:Connect(function(state)
		getgenv().ActiveTween = nil
		if onArrive then onArrive(state) end
	end)
end

--// MAIN LOOP
task.spawn(function()
	while task.wait(0.3) do
		if not ScreenGui.Parent then break end
		if not getgenv().FollowEnabled then continue end

		-- Kalau target udah gak valid / kena block → cari baru
		local cur = getgenv().CurrentTarget
		local needNew = false
		if not cur or not cur.Parent then
			needNew = true
		elseif isBlocked(cur) then
			needNew = true
		elseif not cur.Character or not cur.Character:FindFirstChild("HumanoidRootPart") then
			needNew = true
		end

		if needNew then
			stopTween()
			local nextInfo = pickNextTarget()
			if not nextInfo then
				setStatus("⏸  Tidak ada target valid", C.warn)
				TargetLbl.Text = "Following: —"
				task.wait(1)
				continue
			end
			getgenv().CurrentTarget = nextInfo.plr
			TargetLbl.Text = "Following: " .. nextInfo.plr.Name
			setStatus("🎯 Following " .. nextInfo.plr.Name, C.accent2)
			log("→ Target baru: " .. nextInfo.plr.Name, C.accent2)
		end

		cur = getgenv().CurrentTarget
		if not cur or not cur.Character then continue end
		local curHRP = cur.Character:FindFirstChild("HumanoidRootPart")
		local myHRP = getHRP()
		if not curHRP or not myHRP then continue end

		local dist = (myHRP.Position - curHRP.Position).Magnitude

		-- Kalau udah deket → ganti target
		if dist <= getgenv().SwitchDist then
			setStatus("✅ Deket " .. cur.Name .. " — ganti target", C.success)
			log("Reached " .. cur.Name .. " (" .. math.floor(dist) .. " studs) — switching", C.success)
			stopTween()
			getgenv().CurrentTarget = nil
			task.wait(0.2)
			continue
		end

		-- Kalau ada tween jalan & target gerak, update tween
		if not getgenv().ActiveTween then
			local capturedHRP = curHRP
			local capturedPlr = cur
			tweenToTarget({hrp = capturedHRP, plr = capturedPlr}, function(state)
				if state ~= Enum.PlaybackState.Completed then return end
				if getgenv().CurrentTarget ~= capturedPlr then return end
				-- Sampai tujuan, tunggu loop berikutnya buat switch
			end)
			setStatus(string.format("🏃 Ke %s — %d studs", cur.Name, math.floor(dist)), C.accent2)
		else
			-- Update status doang
			setStatus(string.format("🏃 Ke %s — %d studs", cur.Name, math.floor(dist)), C.accent2)
		end
	end
end)

