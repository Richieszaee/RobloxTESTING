local function ScanEggs()
	for _,v in pairs(workspace:GetDescendants()) do
		if v.Name:lower():find("egg") and v:IsA("Model") or v:IsA("BasePart") then
			if not ESP_Objects[v] then
				-- Coba cari rarity di Attribute / StringValue
				local rarity = "Common"
				if v:GetAttribute("Rarity") then
					rarity = v:GetAttribute("Rarity")
				elseif v:FindFirstChild("Rarity") then
					rarity = v.Rarity.Value
				end
				if ESP_ON then CreateESP(v, rarity) end
			end
		end
	end
end

-- LOOP
RunService.Heartbeat:Connect(function()
	if ESP_ON then
		ScanEggs()
	else
		for obj,_ in pairs(ESP_Objects) do ClearESP(obj) end
	end
end)

