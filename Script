-- ========== SLIDERS ==========
local function makeSlider(parent, x, y, w, name, min, max, default, accent, cb)
	local box = Instance.new("Frame")
	box.Parent = parent
	box.Position = UDim2.new(0, x, 0, y)
	box.Size = UDim2.new(0, w, 0, 56)
	box.BackgroundColor3 = C.surface
	box.BorderSizePixel = 0
	box.ZIndex = 5
	corner(box, 10)
	stroke(box, C.stroke, 1)

	local lbl = Instance.new("TextLabel")
	lbl.Parent = box
	lbl.Position = UDim2.new(0, 12, 0, 8)
	lbl.Size = UDim2.new(1, -70, 0, 16)
	lbl.BackgroundTransparency = 1
	lbl.Text = name
	lbl.TextColor3 = C.textDim
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 6

	local valLbl = Instance.new("TextLabel")
	valLbl.Parent = box
	valLbl.Position = UDim2.new(1, -50, 0, 6)
	valLbl.Size = UDim2.new(0, 42, 0, 20)
	valLbl.BackgroundColor3 = C.surface2
	valLbl.Text = tostring(default)
	valLbl.TextColor3 = accent
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 11
	valLbl.ZIndex = 6
	corner(valLbl, 6)

	local bar = Instance.new("Frame")
	bar.Parent = box
	bar.Position = UDim2.new(0, 12, 0, 36)
	bar.Size = UDim2.new(1, -24, 0, 6)
	bar.BackgroundColor3 = C.bg
	bar.BorderSizePixel = 0
	bar.ZIndex = 6
	corner(bar, 3)

	local fill = Instance.new("Frame")
	fill.Parent = bar
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = accent
	fill.BorderSizePixel = 0
	fill.ZIndex = 7
	corner(fill, 3)

	local knob = Instance.new("Frame")
	knob.Parent = bar
	knob.Size = UDim2.new(0, 12, 0, 12)
	knob.Position = UDim2.new((default - min) / (max - min), 0, 0.5, -6)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.ZIndex = 8
	corner(knob, 6)

	local hit = Instance.new("TextButton")
	hit.Parent = box
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.ZIndex = 9

	local dragging = false
	local function update(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * rel)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, -6, 0.5, -6)
		valLbl.Text = tostring(v)
		cb(v)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; update(i)
		end
	end)
	hit.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			update(i)
		end
	end)
end

