local GodBox = Tabs.Main:AddLeftGroupbox('God Options')
GodBox:AddToggle('GodMode', { Text = 'Enable God Mode', Default = true, Callback = function(v) State.GodMode = v end })
GodBox:AddToggle('NoStun', { Text = 'No Stun / Anti-Trip', Default = true, Callback = function(v) State.NoStun = v end })
GodBox:AddToggle('SpeedHack', { Text = 'God Speed', Default = false, Callback = function(v) State.SpeedHack = v end })
GodBox:AddSlider('WalkSpeed', { Text = 'Speed Value', Default = 28, Min = 16, Max = 100, Callback = function(v) State.WalkSpeed = v end })

local StealBox = Tabs.Main:AddRightGroupbox('Auto Steal')
StealBox:AddToggle('AutoSteal', { Text = 'Auto Steal Egg', Default = false, Callback = function(v) State.AutoSteal = v end })
StealBox:AddSlider('TweenSpeed', { Text = 'Walk Speed Tween', Default = 70, Min = 40, Max = 150, Callback = function(v) State.TweenSpeed = v end })
StealBox:AddLabel("Tips: 40-70 = Aman dari Guard")

-- ── SETTINGS TAB ──
local SettingsBox = Tabs.Config:AddLeftGroupbox('Menu Control')
SettingsBox:AddLabel('Menu Keybind'):AddKeyPicker('MenuKeybind', { Default = 'RightShift', NoUI = true, Text = 'Menu Keybind' })
SettingsBox:AddButton('Stop All Tween', function() if CurrentTween then CurrentTween:Cancel() end)
SettingsBox:AddButton('Unload Script', function() GodLoop:Disconnect() Library:Unload() end)

Library:Notify({ Title = 'RICHIE OMEGA LOADED', Description = 'Press RightShift to Hide GUI.', Time = 5 })
