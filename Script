-- FUNCTION MINIMIZE
local minimized = false
mini.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		Main.Size = UDim2.new(0,220,0,25) -- kecilin
		mini.Text = "+"
		eventLabel.Visible = false
		timeLabel.Visible = false
		btn.Visible = false
	else
		Main.Size = UDim2.new(0,220,0,130) -- balikin
		mini.Text = "-"
		eventLabel.Visible = true
		timeLabel.Visible = true
		btn.Visible = true
	end
end)

-- FUNCTION SCAN EVENT
local function ScanEvent()
	eventLabel.Text = "Scanning..."
	for _,v in pairs(RS:GetDescendants()) do
		if v:IsA("StringValue") and v.Name:lower():find("event") then
			eventLabel.Text = "Event: "..v.Value
			if v.Parent:FindFirstChild("Time") then
				timeLabel.Text = "Time: "..v.Parent.Time.Value
			end
			return
		end
	end
	eventLabel.Text = "Event: Tidak ketemu"
end

btn.MouseButton1Click:Connect(ScanEvent)
ScanEvent()
