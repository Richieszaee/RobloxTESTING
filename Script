--[[
    RICHIE OMEGA V12.1 — STEAL EGG EDITION
    ───────────────────────────────────────────
    Target:    Steal An Egg
    God Mode:  Health Lock + No Stun
    Auto Steal: Tween Walk + FieldEggCarry Remote
    UI:        Obsidian Style
    ───────────────────────────────────────────
]]

-- ============================================================
-- LOAD LIBRARIES
-- ============================================================
local obsidianRepo = 'https://raw.githubusercontent.com/deividcomsono/Obsidian/main/'
local Library      = loadstring(game:HttpGet(obsidianRepo .. 'Library.lua'))()
local ThemeManager = loadstring(game:HttpGet(obsidianRepo .. 'addons/ThemeManager.lua'))()

-- ============================================================
-- SERVICES & CONSTANTS
-- ============================================================
local Players           = game:GetService('Players')
local RunService        = game:GetService('RunService')
local TweenService      = game:GetService('TweenService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera

-- REMOTE BARU SESUAI SS LU
local Networking = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Networking")
local TakeEgg = Networking:WaitForChild("RE"):WaitForChild("EggWorld"):WaitForChild("FieldEggCarry")

-- ============================================================
-- STATE
-- ============================================================
local State = {
    GodMode       = true,
    NoStun        = true,
    SpeedHack     = false,
    WalkSpeed     = 28,
    AutoSteal     = false,
    TweenSpeed    = 70, -- kecepatan jalan. 40-70 aman dari guard
}

local CurrentTween = nil
local GodLoop

-- ============================================================
-- GOD MODE & NO STUN
-- ============================================================
GodLoop = RunService.Heartbeat:Connect(function()
    if not State.GodMode then return end
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if hum then
        if hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
        
        if State.NoStun then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            if hum:GetState() == Enum.HumanoidStateType.FallingDown or hum:GetState() == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end

        if State.SpeedHack then
            hum.WalkSpeed = State.WalkSpeed
        end
    end
end)

-- ============================================================
-- TWEEN WALK FUNCTION
-- ============================================================
local function WalkTo(pos)
	if CurrentTween then CurrentTween:Cancel() end
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local dist = (hrp.Position - pos).Magnitude
	local time = dist / State.TweenSpeed
	CurrentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos + Vector3.new(0,3,0))})
	CurrentTween:Play()
end

-- ============================================================
-- AUTO STEAL LOGIC
-- ============================================================
task.spawn(function()
	while task.wait(0.5) do
		if State.AutoSteal then
			local objects = workspace:FindFirstChild("__OBJECTS")
			if objects then
				for _,obj in pairs(objects:GetChildren()) do
					if obj.Name:lower():find("egg") and obj:FindFirstChild("HumanoidRootPart") then
						local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
						if hrp then
							local dist = (hrp.Position - obj.HumanoidRootPart.Position).Magnitude
							if dist < 200 then -- cuma ambil yg deket
								WalkTo(obj.HumanoidRootPart.Position)
								task.wait(0.6)
								pcall(function() TakeEgg:FireServer(obj) end) -- STEAL
								task.wait(0.2)
							end
						end
					end
				end
			end
		end
	end
end)

-- ============================================================
-- UI CONSTRUCTION
-- ============================================================
