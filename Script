local CurrentTween = nil

-- FUNCTION
local function TweenTo(pos)
	if Moving then if CurrentTween then CurrentTween:Cancel() end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	Moving = true
	local dist = (hrp.Position - pos).Magnitude
	local time = dist / TweenSpeed
	CurrentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
	CurrentTween:Play()
	CurrentTween.Completed:Connect(function() Moving = false end)
end

local function UpdateLabel()
	speedLabel.Text = "Speed: "..TweenSpeed
end

minusBtn.MouseButton1Click:Connect(function()
	TweenSpeed = math.clamp(TweenSpeed - 50, 100, 1000)
	UpdateLabel()
end)

plusBtn.MouseButton1Click:Connect(function()
	TweenSpeed = math.clamp(TweenSpeed + 50, 100, 1000)
	UpdateLabel()
end)

forwardBtn.MouseButton1Click:Connect(function()
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		local targetPos = hrp.CFrame + hrp.CFrame.LookVector * 30 -- jalan maju 30 stud
		TweenTo(targetPos.Position)
	end
end)

stopBtn.MouseButton1Click:Connect(function()
	if CurrentTween then CurrentTween:Cancel() end
	Moving = false
end)

mouseBtn.MouseButton1Click:Connect(function()
	local mouse = LP:GetMouse()
	TweenTo(mouse.Hit.Position) -- tween ke tempat kursor klik
end)

-- SCROLL BUAT GANTI SPEED
UIS.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		TweenSpeed = math.clamp(TweenSpeed + input.Position.Z * 50, 100, 1000)
		UpdateLabel()
	end
end)

