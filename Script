local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LP = Players.LocalPlayer

local TweenSpeed = 80 -- 80 = jalan pelan biar ga ke detect guard
local CurrentTween = nil
local AutoSteal = false

-- REMOTE BARU
local Networking = RS:WaitForChild("Packages"):WaitForChild("Networking")
local TakeEgg = Networking:WaitForChild("RE"):WaitForChild("EggWorld"):WaitForChild("FieldEggCarry")

-- GUI SIMPLE
local gui = Instance.new("ScreenGui", LP.PlayerGui)
gui.Name = "StealHub"
local Main = Instance.new("Frame", gui)
Main.Size = UDim2.new(0, 200, 0, 100)
Main.Position = UDim2.new(0, 20, 0, 20)
Main.BackgroundColor3 = Color3.fromRGB(15,15,15)
Instance.new("UICorner", Main).CornerRadius = UDim.new(0,10)

local toggleBtn = Instance.new("TextButton", Main)
toggleBtn.Size = UDim2.new(1,-20,0,40)
toggleBtn.Position = UDim2.new(0,10,0,10)
toggleBtn.Text = "AUTO STEAL: OFF"
toggleBtn.BackgroundColor3 = Color3.fromRGB(200,50,50)
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0,8)

local speedLabel = Instance.new("TextLabel", Main)
speedLabel.Size = UDim2.new(1,-20,0,20)
speedLabel.Position = UDim2.new(0,10,0,55)
speedLabel.Text = "Speed: "..TweenSpeed.." | Scroll"
speedLabel.BackgroundTransparency = 1
speedLabel.TextColor3 = Color3.new(1,1,1)

-- FUNCTION JALAN PAKE TWEEN
local function WalkTo(pos)
	if CurrentTween then CurrentTween:Cancel() end
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local dist = (hrp.Position - pos).Magnitude
	local time = dist / TweenSpeed
	CurrentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
	CurrentTween:Play()
end

-- FUNCTION STEAL
local function StealEgg(egg)
	if not egg or not egg.Parent then return end
	pcall(function()
		TakeEgg:FireServer(egg) -- remote baru
	end)
end

-- LOOP AUTO STEAL
task.spawn(function()
	while task.wait(0.3) do
		if AutoSteal then
			for _,obj in pairs(workspace:WaitForChild("__OBJECTS"):GetChildren()) do
				if obj.Name:lower():find("egg") and obj:FindFirstChild("HumanoidRootPart") then
					local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
					if hrp and (hrp.Position - obj.HumanoidRootPart.Position).Magnitude < 150 then
						WalkTo(obj.HumanoidRootPart.Position) -- jalan dulu ke telur
						task.wait(0.5)
						StealEgg(obj) -- baru ambil
					end
				end
			end
		end
	end
end)

-- TOMBOL
toggleBtn.MouseButton1Click:Connect(function()
	AutoSteal = not AutoSteal
	toggleBtn.Text = "AUTO STEAL: "..(AutoSteal and "ON" or "OFF")
	toggleBtn.BackgroundColor3 = AutoSteal and Color3.fromRGB(0,200,80) or Color3.fromRGB(200,50,50)
end)

-- SCROLL GANTI SPEED
game:GetService("UserInputService").InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		TweenSpeed = math.clamp(TweenSpeed + input.Position.Z * 10, 40, 200)
		speedLabel.Text = "Speed: "..TweenSpeed.." | Scroll"
	end
end)

