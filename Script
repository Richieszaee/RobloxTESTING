local function updateDistance(dist)
	local range = 200
	local fillRel = math.clamp(1 - (dist / range), 0, 1)
	DistFill.Size = UDim2.new(fillRel, 0, 1, 0)
	if dist <= getgenv().SwitchDist then
		DistFill.BackgroundColor3 = C.success
	elseif dist <= getgenv().SwitchDist * 3 then
		DistFill.BackgroundColor3 = C.warn
	else
		DistFill.BackgroundColor3 = C.accent2
	end
end

