-- ========== PLAYER LIST RENDER ==========
local function isBlocked(plr)
	return getgenv().Blocklist[plr.UserId] == true
end

function refreshPlayerList()
	for _, c in ipairs(ListScroll:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end

	local blockedCount = 0
	for _ in pairs(getgenv().Blocklist) do blockedCount = blockedCount + 1 end
	BlockCountLbl.Text = "Blocked: " .. blockedCount

	local allPlayers = Players:GetPlayers()
	table.sort(allPlayers, function(a, b)
		if a == LP then return false end
		if b == LP then return true end
		return a.Name:lower() < b.Name:lower()
	end)

	local activeTarget = getgenv().CurrentTarget

	for _, plr in ipairs(allPlayers) do
		if plr == LP then continue end
		local blocked = isBlocked(plr)
		local isTarget = (plr == activeTarget)

		local row = Instance.new("TextButton")
		row.Parent = ListScroll
		row.Size = UDim2.new(1, -4, 0, 40)
		row.BackgroundColor3 = isTarget and Color3.fromRGB(45, 35, 90)
			or (blocked and Color3.fromRGB(60, 25, 35) or C.surface2)
		row.BorderSizePixel = 0
		row.Text = ""
		row.AutoButtonColor = false
		corner(row, 10)

		stroke(row, isTarget and C.accent
			or (blocked and C.danger or C.stroke), isTarget and 2 or 1)

		local av = Instance.new("Frame")
		av.Parent = row
		av.Size = UDim2.new(0, 28, 0, 28)
		av.Position = UDim2.new(0, 8, 0.5, -14)
		av.BackgroundColor3 = isTarget and C.accent or C.surface3
		av.BorderSizePixel = 0
		corner(av, 8)

		local avTxt = Instance.new("TextLabel")
		avTxt.Parent = av
		avTxt.Size = UDim2.new(1, 0, 1, 0)
		avTxt.BackgroundTransparency = 1
		avTxt.Text = plr.Name:sub(1, 1):upper()
		avTxt.TextColor3 = Color3.fromRGB(255, 255, 255)
		avTxt.Font = Enum.Font.GothamBold
		avTxt.TextSize = 14

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Parent = row
		nameLbl.Position = UDim2.new(0, 44, 0, 4)
		nameLbl.Size = UDim2.new(1, -130, 0, 16)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = plr.Name
		nameLbl.TextColor3 = blocked and C.danger or (isTarget and C.accent2 or C.text)
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextSize = 12
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

		local dispLbl = Instance.new("TextLabel")
		dispLbl.Parent = row
		dispLbl.Position = UDim2.new(0, 44, 0, 20)
		dispLbl.Size = UDim2.new(1, -130, 0, 14)
		dispLbl.BackgroundTransparency = 1
		dispLbl.Text = "@" .. plr.DisplayName
		dispLbl.TextColor3 = C.textMuted
		dispLbl.Font = Enum.Font.Gotham
		dispLbl.TextSize = 10
		dispLbl.TextXAlignment = Enum.TextXAlignment.Left
		dispLbl.TextTruncate = Enum.TextTruncate.AtEnd

		local tag = Instance.new("TextLabel")
		tag.Parent = row
		tag.Position = UDim2.new(1, -84, 0, 0)
		tag.Size = UDim2.new(0, 76, 1, 0)
		tag.BackgroundTransparency = 1
		if isTarget then
			tag.Text = "🎯 TARGET"
			tag.TextColor3 = C.accent2
		elseif blocked then
			tag.Text = "🚫 BLOCKED"
			tag.TextColor3 = C.danger
		else
			tag.Text = "click"
			tag.TextColor3 = C.textMuted
		end
		tag.Font = Enum.Font.GothamBold
		tag.TextSize = 10
		tag.TextXAlignment = Enum.TextXAlignment.Right

		row.MouseButton1Click:Connect(function()
			if isBlocked(plr) then
				getgenv().Blocklist[plr.UserId] = nil
				log("Unblocked: " .. plr.Name, C.success)
			else
				getgenv().Blocklist[plr.UserId] = true
				log("Blocked: " .. plr.Name, C.danger)
				if getgenv().CurrentTarget == plr then
					if getgenv().ActiveTween then pcall(function() getgenv().ActiveTween:Cancel() end) end
					getgenv().CurrentTarget = nil
					setTargetCard(nil)
				end
			end
			refreshPlayerList()
		end)

		local baseColor = row.BackgroundColor3
		row.MouseEnter:Connect(function()
			if not isTarget then
				TweenService:Create(row, TweenInfo.new(0.12), {
					BackgroundColor3 = blocked and Color3.fromRGB(80, 30, 40) or Color3.fromRGB(42, 42, 58)
				}):Play()
			end
		end)
		row.MouseLeave:Connect(function()
			TweenService:Create(row, TweenInfo.new(0.12), {BackgroundColor3 = baseColor}):Play()
		end)
	end
end

