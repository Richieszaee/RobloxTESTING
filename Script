    local i=1; b.MouseButton1Click:Connect(function() i=i%#options+1; b.Text=name..": "..options[i]; cb(options[i]) end)
end

-- LOGIC UTAMA
local function TweenTo(pos)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return 0 end
	local dist = (hrp.Position - pos.Position).Magnitude
	local time = math.clamp(dist / CFG.TweenSpeed, 0.05, 2.5)
	TS:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = pos}):Play()
	return time
end

local function GetRarityValue(obj)
	local rarity = obj:GetAttribute("Rarity") or "Common"
	return RARITY_ORDER[rarity] or 1
end

local function FindBestEgg()
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local bestEgg, bestScore = nil, 0
	for _,v in pairs(WS:GetDescendants()) do
		if v:IsA("Model") and v.Name:lower():find("egg") then
			local part = v:FindFirstChildWhichIsA("BasePart", true)
			if part then
				local score = GetRarityValue(v)
				if score > bestScore then bestEgg = part bestScore = score end
			end
		end
	end
	return bestEgg
end

