-- LIST TELUR LANGKA
local RareEggs = {
	["Divine Egg"]=true, ["Eternal Egg"]=true, ["Prehistoric Egg"]=true,
	["Mythic Egg"]=true, ["Legendary Egg"]=true, ["Celestial Egg"]=true
}

local sent = {}
local count = 0

-- KIRIM KE WEBHOOK
local function SendToWebhook(egg, pos)
	if WEBHOOK_URL == "PASTE_WEBHOOK_DISCORD_KAMU_DISINI" then
		warn("Ganti dulu WEBHOOK_URL nya!")
		return
	end
	
	local data = {
	["username"] = "SAE Egg Predictor",
	["avatar_url"] = "https://i.imgur.com/egg.png",
	["content"] = "@everyone",
		["embeds"] = {{
			["title"] = "👑 TELUR LANGKA MUNCUL!",
			["description"] = "**"..egg.."** telah spawn di server!",
			["color"] = 16766720,
			["fields"] = {
				{["name"] = "📍 Lokasi", ["value"] = tostring(pos), ["inline"] = true},
				{["name"] = "⏰ Waktu", ["value"] = os.date("%H:%M:%S"), ["inline"] = true}
			},
			["footer"] = {["text"] = "Steal An Egg Predictor"}
	}}
	}
	
	pcall(function()
		request({ -- ganti ke http_request kalo pake executor lain
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode(data)
	})
	end)
end

-- SCAN 1 NEST TIAP 5 DETIK
local function Scan()
	count = count + 1
	scanCount.Text = "Scan ke: "..count
	
	local nests = {}
	for _,v in pairs(WS:GetDescendants()) do
		if v.Name:lower():find("nest") then
			table.insert(nests, v)
		end
	end
	
	if #nests == 0 then status.Text = "Status: Nest tidak ketemu" return end
	
	local index = (count % #nests) + 1
	local nest = nests[index]
	status.Text = "Status: Scan nest "..index.."/"..#nests
	
	local eggVal = nest:FindFirstChild("EggName") or nest:FindFirstChild("NameValue")
	if eggVal and eggVal.Value ~= "" then
		local name = eggVal.Value
		if RareEggs[name] then
			local key = name..tostring(nest)
			if not sent[key] then
				sent[key] = true
				last.Text = "Rare Terakhir: "..name
				SendToWebhook(name, nest.Position)
			end
		end
	end
end

-- LOOP 5 DETIK
task.spawn(function()
	local cd = 5
	while g.Parent do
		task.wait(1)
		cd = cd - 1
		timer.Text = "Scan berikutnya: "..cd.."s"
		if cd <= 0 then
			cd = 5
			Scan()
		end
	end
end)
