-- Chat listener (TextChatService baru + Legacy fallback)
local function hookTextChatService()
    local TC = game:GetService("TextChatService")
    if TC.ChatVersion == Enum.ChatVersion.TextChatService then
        TC.MessageReceived:Connect(function(msg)
            if not getgenv().LogChat then return end
            local prefix = getgenv().Prefix or ""
            local text = msg.Text or ""
            if prefix ~= "" and text:sub(1, #prefix) ~= prefix then return end
            local sender = msg.TextSource and msg.TextSource.Name or "Unknown"
            local userId = msg.TextSource and msg.TextSource.UserId or 0
            sendWebhook({
                title = "📨 Chat Message",
                description = "Pesan baru di chat.",
                color = 0x3498db,
                fields = {
                    {name = "👤 Sender", value = "`" .. sender .. "`", inline = true},
                    {name = "🆔 UserID", value = "`" .. tostring(userId) .. "`", inline = true},
                    {name = "💬 Message", value = "```" .. text .. "```", inline = false}
                },
                footer = baseFooter(),
                thumbnail = {url = thumbURL()}
            })
            pushLog("[Chat] " .. sender .. ": " .. text)
        end)
    end
end

local function hookLegacyChat()
    local RP = game:GetService("ReplicatedStorage")
    local defaultChat = RP:FindFirstChild("DefaultChatSystemChatEvents")
    if defaultChat then
        local onMessage = defaultChat:FindFirstChild("OnMessageDoneFiltering")
        if onMessage then
            onMessage.OnClientEvent:Connect(function(data)
                if not getgenv().LogChat then return end
                local prefix = getgenv().Prefix or ""
                local text = data.Message or ""
                if prefix ~= "" and text:sub(1, #prefix) ~= prefix then return end
                sendWebhook({
                    title = "📨 Chat Message",
                    description = "Pesan baru di chat (legacy).",
                    color = 0x3498db,
                    fields = {
                        {name = "👤 Sender", value = "`" .. tostring(data.FromSpeaker) .. "`", inline = true},
                        {name = "💬 Message", value = "```" .. text .. "```", inline = false}
                    },
                    footer = baseFooter(),
                    thumbnail = {url = thumbURL()}
                })
                pushLog("[Chat] " .. tostring(data.FromSpeaker) .. ": " .. text)
            end)
        end
    end
end

pcall(hookTextChatService)
pcall(hookLegacyChat)

