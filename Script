-- Fetch
local function fetchAndAnalyze(url)
	if url == "" then
		Status.Text = "❌ URL kosong!"
		Status.TextColor3 = C.danger
		return
	end
	if not url:match("^https?://") then
		url = "https://" .. url
		UrlBox.Text = url
	end
	Status.Text = "⏳ Fetching " .. url:sub(1, 60) .. "..."
	Status.TextColor3 = C.warn
	clearContent()
	addLine("⏳ Sedang fetch...", C.warn)
	task.spawn(function()
		local ok, html = pcall(function()
			return game:HttpGet(url, true)
		end)
		if not ok or not html or html == "" then
			Status.Text = "❌ Gagal fetch"
			Status.TextColor3 = C.danger
			clearContent()
			addLine("❌ Gagal fetch URL ini.", C.danger)
			addLine("Error: " .. tostring(html), Color3.fromRGB(255, 150, 150))
			return
		end
		analyzeHTML(url, html)
		Status.Text = string.format("✅ %s — %d bytes", url:sub(1, 50), #html)
		Status.TextColor3 = C.success
		renderTab(activeTab)
	end)
end

AnalyzeBtn.MouseButton1Click:Connect(function() fetchAndAnalyze(UrlBox.Text) end)
UrlBox.FocusLost:Connect(function(enter) if enter then fetchAndAnalyze(UrlBox.Text) end end)
