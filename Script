closeBtn.BackgroundColor3 = Color3.fromRGB(255,50,50)
closeBtn.TextColor3 = Color3.new(1,1,1)
closeBtn.Font = Enum.Font.GothamBold
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0,5)
closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

-- SCROLL GANTI SPEED
UIS.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		TweenSpeed = math.clamp(TweenSpeed + input.Position.Z * 50, 100, 1000)
		speedLabel.Text = "Speed: "..TweenSpeed.." | Scroll Mouse"
	end
end)

Players.PlayerAdded:Connect(function(plr) table.insert(playerList, plr) end)

print("[Warp Classic] Loaded")
