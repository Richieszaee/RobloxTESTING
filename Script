-- FUNGSI GUI
local function Btn(name,cb) local b=Instance.new("TextButton",scroll); b.Size=UDim2.new(1,0,0,35) b.BackgroundColor3=C.Btn b.Text=name b.TextColor3=C.Txt b.Font=Enum.Font.GothamBold b.TextSize=12 Instance.new("UICorner",b).CornerRadius=UDim.new(0,8) b.MouseButton1Click:Connect(cb) return b end
local function Tog(name,def,cb) local b=Instance.new("TextButton",scroll); b.Size=UDim2.new(1,0,0,35) b.BackgroundColor3=C.Btn Instance.new("UICorner",b).CornerRadius=UDim.new(0,8) local l=Instance.new("TextLabel",b); l.Size=UDim2.new(1,-85,1,0) l.Position=UDim2.new(0,12,0,0) l.BackgroundTransparency=1 l.Text=name l.TextColor3=C.Txt l.Font=Enum.Font.GothamSemibold l.TextSize=12 l.TextXAlignment=Enum.TextXAlignment.Left local s=Instance.new("TextLabel",b); s.Size=UDim2.new(0,55,0,22) s.Position=UDim2.new(1,-65,0.5,-11) s.BackgroundColor3=def and C.On or C.Off s.Text=def and "ON" or "OFF" s.TextColor3=Color3.new(1,1,1) s.Font=Enum.Font.GothamBold s.TextSize=10 Instance.new("UICorner",s).CornerRadius=UDim.new(0,5) local st=def b.MouseButton1Click:Connect(function() st=not st s.Text=st and "ON" or "OFF" TS:Create(s, TweenInfo.new(0.15), {BackgroundColor3=st and C.On or C.Off}):Play() cb(st) end) end
local function Slider(name,mn,mx,def,cb) local f=Instance.new("Frame",scroll); f.Size=UDim2.new(1,0,0,50) f.BackgroundColor3=C.Btn Instance.new("UICorner",f).CornerRadius=UDim.new(0,8) local l=Instance.new("TextLabel",f); l.Size=UDim2.new(1,-20,0,22) l.Position=UDim2.new(0,12,0,4) l.BackgroundTransparency=1 l.Text=name..": "..def l.TextColor3=C.Txt l.Font=Enum.Font.GothamSemibold l.TextSize=11 l.TextXAlignment=Enum.TextXAlignment.Left local bg=Instance.new("Frame",f); bg.Size=UDim2.new(1,-24,0,6) bg.Position=UDim2.new(0,12,0,32) bg.BackgroundColor3=C.Card Instance.new("UICorner",bg).CornerRadius=UDim.new(0,3) local fl=Instance.new("Frame",bg); fl.Size=UDim2.new((def-mn)/(mx-mn),0,1,0) fl.BackgroundColor3=Color3.fromRGB(138,138,138) Instance.new("UICorner",fl).CornerRadius=UDim.new(0,3) local drag=false local function upd(i) local r=math.clamp((i.Position.X-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1) local v=math.floor(mn+(mx-mn)*r) TS:Create(fl, TweenInfo.new(0.1), {Size=UDim2.new(r,0,1,0)}):Play() l.Text=name..": "..v cb(v) end bg.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true upd(i) end) UIS.InputChanged:Connect(function(i) if drag and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i) end) UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end) end

-- LOGIC
local function TweenTo(pos) local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return 0 end local dist = (hrp.Position - pos.Position).Magnitude local time = math.clamp(dist / CFG.TweenSpeed, 0.05, 2.5) TS:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = pos}):Play() return time end
local function GetRarityValue(obj) local rarity = obj:GetAttribute("Rarity") or "Common" return RARITY_ORDER[rarity] or 1 end
local function FindBestEgg() local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return nil end local bestEgg, bestScore = nil, 0 for _,v in pairs(WS:GetDescendants()) do if v:IsA("Model") and v.Name:lower():find("egg") then local part = v:FindFirstChildWhichIsA("BasePart", true) if part then local score = GetRarityValue(v) if score > bestScore then bestEgg = part bestScore = score end end return bestEgg end

