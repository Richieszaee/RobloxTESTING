-- HTML helpers (same as before)
local function getMeta(html, attr, value)
	local p1 = '<meta[^>]*' .. attr .. '="' .. value .. '"[^>]*content="([^"]*)"'
	local p2 = '<meta[^>]*content="([^"]*)"[^>]*' .. attr .. '="' .. value .. '"'
	return html:match(p1) or html:match(p2)
end

local function countMatches(str, pattern)
	local c = 0
	for _ in str:gmatch(pattern) do c = c + 1 end
	return c
end

local function collectMatches(str, pattern)
	local list = {}
	for m in str:gmatch(pattern) do table.insert(list, m) end
	return list
end

local Analysis = {}

local function analyzeHTML(url, html)
	local a = {}
	a.url = url
	a.html = html
	a.bytes = #html
	a.isHttps = url:sub(1, 6) == "https:"
	a.title = html:match("<title[^>]*>([^<]*)</title>") or ""
	a.desc = getMeta(html, "name", "description") or ""
	a.keywords = getMeta(html, "name", "keywords") or ""
	a.author = getMeta(html, "name", "author") or ""
	a.lang = html:match('<html[^>]*lang="([^"]*)"') or ""
	a.charset = html:match('<meta[^>]*charset="([^"]*)"') or html:match('charset=([%w%-]+)') or ""
	a.ogTitle = getMeta(html, "property", "og:title") or ""
	a.ogDesc = getMeta(html, "property", "og:description") or ""
	a.ogImage = getMeta(html, "property", "og:image") or ""
	a.ogUrl = getMeta(html, "property", "og:url") or ""
	a.ogType = getMeta(html, "property", "og:type") or ""
	a.ogSite = getMeta(html, "property", "og:site_name") or ""
	a.twCard = getMeta(html, "name", "twitter:card") or ""
	a.twTitle = getMeta(html, "name", "twitter:title") or ""
	a.twDesc = getMeta(html, "name", "twitter:description") or ""
	a.twImage = getMeta(html, "name", "twitter:image") or ""
	a.links = collectMatches(html, '<a[^>]*href="([^"]*)"')
	a.images = collectMatches(html, '<img[^>]*src="([^"]*)"')
	a.scripts = collectMatches(html, '<script[^>]*src="([^"]*)"')
	a.styles = collectMatches(html, '<link[^>]*rel="stylesheet"[^>]*href="([^"]*)"')
	a.forms = countMatches(html, "<form")
	a.h1 = countMatches(html, "<h1")
	a.h2 = countMatches(html, "<h2")
	a.h3 = countMatches(html, "<h3")
	a.paragraphs = countMatches(html, "<p[ >]")
	a.inlineScripts = countMatches(html, "<script[^>]*>") - #a.scripts
	a.inlineStyles = countMatches(html, "<style[^>]*>")
	a.hasViewport = html:find('name="viewport"', 1, true) ~= nil
	a.hasFavicon = html:find('rel="icon"', 1, true) ~= nil or html:find('rel="shortcut icon"', 1, true) ~= nil
	a.hasCanonical = html:find('rel="canonical"', 1, true) ~= nil
	a.hasRobots = html:find('name="robots"', 1, true) ~= nil

	local domains = {}
	local ownDomain = url:match("^https?://([^/]+)") or ""
	for _, link in ipairs(a.links) do
		local d = link:match("^https?://([^/]+)")
		if d and d ~= ownDomain then domains[d] = true end
	end
	a.externalDomains = {}
	for d in pairs(domains) do table.insert(a.externalDomains, d) end
	table.sort(a.externalDomains)
	Analysis = a
end

-- Render
local function renderTab(name)
	clearContent()
	resetTabStore(name)
	if not Analysis.html or Analysis.html == "" then
		addLine("Belum ada data. Fetch URL dulu.", C.warn)
		return
	end
	local a = Analysis

	if name == "Info" then
		addHeader("PAGE OVERVIEW")
		addKeyValue("URL", a.url, C.accent2)
		addKeyValue("HTTPS", a.isHttps and "Ya" or "Tidak", a.isHttps and C.success or C.danger)
		addKeyValue("Size", a.bytes .. " bytes (" .. string.format("%.2f", a.bytes/1024) .. " KB)")
		addKeyValue("Title", a.title ~= "" and a.title or "(kosong)")
		addKeyValue("Description", a.desc ~= "" and a.desc or "(kosong)")
		addKeyValue("Lang", a.lang ~= "" and a.lang or "(tidak set)")
		addKeyValue("Charset", a.charset ~= "" and a.charset or "(tidak set)")
		addHeader("STRUKTUR")
		addKeyValue("H1", a.h1)
		addKeyValue("H2", a.h2)
		addKeyValue("H3", a.h3)
		addKeyValue("Paragraphs", a.paragraphs)
		addKeyValue("Forms", a.forms)
		addKeyValue("Links", #a.links)
		addKeyValue("Images", #a.images)
		addKeyValue("Scripts (external)", #a.scripts)
		addKeyValue("Scripts (inline)", a.inlineScripts)
		addKeyValue("Stylesheets", #a.styles)

	elseif name == "Meta" then
		addHeader("BASIC META")
		addKeyValue("Title", a.title ~= "" and a.title or "(kosong)")
		addKeyValue("Description", a.desc ~= "" and a.desc or "(kosong)")
		addKeyValue("Keywords", a.keywords ~= "" and a.keywords or "(kosong)")
		addKeyValue("Author", a.author ~= "" and a.author or "(kosong)")
		addHeader("OPEN GRAPH")
		addKeyValue("og:title", a.ogTitle ~= "" and a.ogTitle or "(kosong)")
		addKeyValue("og:description", a.ogDesc ~= "" and a.ogDesc or "(kosong)")
		addKeyValue("og:type", a.ogType ~= "" and a.ogType or "(kosong)")
		addKeyValue("og:url", a.ogUrl ~= "" and a.ogUrl or "(kosong)")
		addKeyValue("og:image", a.ogImage ~= "" and a.ogImage or "(kosong)")
		addKeyValue("og:site_name", a.ogSite ~= "" and a.ogSite or "(kosong)")
		addHeader("TWITTER CARD")
		addKeyValue("twitter:card", a.twCard ~= "" and a.twCard or "(kosong)")
		addKeyValue("twitter:title", a.twTitle ~= "" and a.twTitle or "(kosong)")
		addKeyValue("twitter:description", a.twDesc ~= "" and a.twDesc or "(kosong)")
		addKeyValue("twitter:image", a.twImage ~= "" and a.twImage or "(kosong)")

	elseif name == "Links" then
		addHeader("LINKS (" .. #a.links .. ")")
		if #a.links == 0 then addLine("(tidak ada link)", C.textMuted) end
		for i = 1, #a.links do addLine(string.format("%d. %s", i, a.links[i])) end
		addHeader("DOMAIN EKSTERNAL (" .. #a.externalDomains .. ")")
		for _, d in ipairs(a.externalDomains) do addLine("• " .. d, C.warn) end

	elseif name == "Media" then
		addHeader("IMAGES (" .. #a.images .. ")")
		if #a.images == 0 then addLine("(tidak ada image)", C.textMuted) end
		for i = 1, #a.images do addLine(string.format("%d. %s", i, a.images[i])) end
		addHeader("SCRIPTS (" .. #a.scripts .. ")")
		for i = 1, #a.scripts do addLine(string.format("%d. %s", i, a.scripts[i])) end
		addHeader("STYLESHEETS (" .. #a.styles .. ")")
		for i = 1, #a.styles do addLine(string.format("%d. %s", i, a.styles[i])) end

	elseif name == "Security" then
		addHeader("SECURITY CHECK")
		addKeyValue("HTTPS", a.isHttps and "Ya" or "Tidak", a.isHttps and C.success or C.danger)
		addKeyValue("Viewport meta", a.hasViewport and "Ada" or "Tidak", a.hasViewport and C.success or C.warn)
		addKeyValue("Favicon", a.hasFavicon and "Ada" or "Tidak", a.hasFavicon and C.success or C.warn)
		addKeyValue("Canonical URL", a.hasCanonical and "Ada" or "Tidak")
		addKeyValue("Robots meta", a.hasRobots and "Ada" or "Tidak")
		addHeader("WARNING")
		local warns = 0
		if not a.isHttps then addLine("⚠️ Situs tidak pakai HTTPS!", C.danger); warns = warns + 1 end
		if not a.hasViewport then addLine("⚠️ Tidak ada viewport meta", C.warn); warns = warns + 1 end
		if a.title == "" then addLine("⚠️ Tidak ada title tag", C.warn); warns = warns + 1 end
		if a.desc == "" then addLine("⚠️ Tidak ada meta description", C.warn); warns = warns + 1 end
		if a.h1 == 0 then addLine("⚠️ Tidak ada tag H1", C.warn); warns = warns + 1 end
		if a.h1 > 1 then addLine("⚠️ Ada " .. a.h1 .. " tag H1 (sebaiknya 1)", C.warn); warns = warns + 1 end
		if warns == 0 then addLine("✅ Tidak ada warning", C.success) end

	elseif name == "Raw" then
		addHeader("RAW HTML (" .. a.bytes .. " bytes)")
		addLine(a.html)
	end
end

-- Build text
local function buildTabText(tab)
	local lines = tabTextStore[tab] or {}
	return table.concat(lines, "\n")
end

local function buildAllText()
	local parts = {}
	table.insert(parts, "========================================")
	table.insert(parts, "WEBSITE ANALYSIS REPORT")
	table.insert(parts, "========================================")
	table.insert(parts, "URL   : " .. (Analysis.url or "-"))
	table.insert(parts, "Date  : " .. os.date("%Y-%m-%d %H:%M:%S"))
	table.insert(parts, "Size  : " .. (Analysis.bytes or 0) .. " bytes")
	table.insert(parts, "========================================\n")
	for _, t in ipairs(tabNames) do
		local oldActive = activeTab
		activeTab = t.label
		resetTabStore(t.label)
		renderTab(t.label)
		activeTab = oldActive
		table.insert(parts, "\n######## " .. t.label .. " ########")
		table.insert(parts, buildTabText(t.label))
		table.insert(parts, "")
	end
	renderTab(activeTab)
	return table.concat(parts, "\n")
end

-- Copy handlers
local function doCopyTab()
	if not Analysis.html then
		Status.Text = "❌ Belum ada data untuk di-copy"
		Status.TextColor3 = C.danger
		return
	end
	local text = buildTabText(activeTab)
	if #text == 0 then
		Status.Text = "❌ Tab ini kosong"
		Status.TextColor3 = C.danger
		return
	end
	if copyClip(text) then
		Status.Text = "✅ Copied tab " .. activeTab .. " (" .. #text .. " chars)"
		Status.TextColor3 = C.success
	else
		Status.Text = "❌ Gagal copy (setclipboard unsupported)"
		Status.TextColor3 = C.danger
	end
end

local function doCopyAll()
	if not Analysis.html then
		Status.Text = "❌ Belum ada data"
		Status.TextColor3 = C.danger
		return
	end
	Status.Text = "⏳ Building report..."
	Status.TextColor3 = C.warn
	task.spawn(function()
		local text = buildAllText()
		if copyClip(text) then
			Status.Text = "✅ Copied SEMUA (" .. #text .. " chars, " .. math.floor(#text/1024) .. " KB)"
			Status.TextColor3 = C.success
		else
			Status.Text = "❌ Gagal copy"
			Status.TextColor3 = C.danger
		end
	end)
end

-- Tab buttons
local function createTab(tabDef, index)
	local btn = Instance.new("TextButton")
	btn.Parent = TabBar
	btn.Size = UDim2.new(0, 108, 1, 0)
	btn.BackgroundColor3 = C.bg
	btn.BackgroundTransparency = 0.4
	btn.BorderSizePixel = 0
	btn.Text = tabDef.icon .. "  " .. tabDef.label
	btn.TextColor3 = C.textDim
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 12
	corner(btn, 8)
	clickFx(btn)

	btn.MouseButton1Click:Connect(function()
		activeTab = tabDef.label
		for _, t in pairs(tabs) do
			TweenService:Create(t.btn, TweenInfo.new(0.2), {
				BackgroundColor3 = C.bg,
				BackgroundTransparency = 0.4,
				TextColor3 = C.textDim,
			}):Play()
		end
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = C.accent,
			BackgroundTransparency = 0,
			TextColor3 = Color3.fromRGB(255, 255, 255),
		}):Play()
		renderTab(tabDef.label)
	end)

	btn.MouseEnter:Connect(function()
		if activeTab ~= tabDef.label then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.1}):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if activeTab ~= tabDef.label then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.4}):Play()
		end
	end)

	tabs[tabDef.label] = {btn = btn}
end

