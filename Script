end

task.spawn(function()
	while task.wait(0.25) do
		if not ScreenGui.Parent then break end
		if not getgenv().FollowEnabled then continue end

		local cur = getgenv().CurrentTarget
		local needNew = false
		if not cur or not cur.Parent then needNew = true
		elseif isBlocked(cur) then needNew = true
		elseif not cur.Character or not cur.Character:FindFirstChild("HumanoidRootPart") then needNew = true
		end

		if needNew then
			stopTween()
			local nextInfo = pickNextTarget()
			if not nextInfo then
				setTargetCard(nil)
				log("⏸  Tidak ada target valid", C.warn)
				task.wait(1)
				continue
			end
			getgenv().CurrentTarget = nextInfo.plr
			setTargetCard(nextInfo.plr)
			log("→ Target: " .. nextInfo.plr.Name .. " (" .. math.floor(nextInfo.dist) .. " studs)", C.accent2)
		end

		cur = getgenv().CurrentTarget
		if not cur or not cur.Character then continue end
		local curHRP = cur.Character:FindFirstChild("HumanoidRootPart")
		local myHRP = getHRP()
		if not curHRP or not myHRP then continue end

		local dist = (myHRP.Position - curHRP.Position).Magnitude
		updateDistance(dist)

		if dist <= getgenv().SwitchDist then
			getgenv().SwitchCount = getgenv().SwitchCount + 1
			SwitchLbl.Text = "🔄 " .. getgenv().SwitchCount
			log("✅ Deket " .. cur.Name .. " → ganti target!", C.success)
			playSwitchFx()
			stopTween()
			getgenv().CurrentTarget = nil
			setTargetCard(nil)
			task.wait(0.35)
			local nextInfo = pickNextTarget()
			if nextInfo then
				getgenv().CurrentTarget = nextInfo.plr
				setTargetCard(nextInfo.plr)
				log("→ Target baru: " .. nextInfo.plr.Name, C.accent2)
			end
			continue
		end

		if not getgenv().ActiveTween then
			tweenToTarget({hrp = curHRP, plr = cur})
		end

		if TargetSubLbl then
			TargetSubLbl.Text = "@" .. cur.DisplayName .. "  •  " .. math.floor(dist) .. " studs"
		end
	end
end)

