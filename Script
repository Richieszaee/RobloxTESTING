-- LIST RARITY TERTINGGI DARI CONFIG
local RareList = {
	["Eternal"] = true, -- 1 in 100,000,000
	["Divine"] = true,
	["Mythic"] = true,
	["Legendary"] = true,
	["Prehistoric"] = true,
	["Celestial"] = true
}

local sent = {}

local function SendWebhook(rarity, data)
	if WEBHOOK_URL == "WEBHOOK_BARU_KAMU" then status.Text = "Error: Isi webhook dulu" return end
	
	pcall(function()
		syn.request({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({
				content = "@everyone",
				embeds = {{
					title = "👑 "..rarity.." EGG DETECTED!",
					description = "**"..data.DisplayName.."** rarity spawned!",
					color = 16711935,
					fields = {
						{name = "Rate", value = data.DefaultRarityValue, inline = true},
						{name = "Time", value = os.date("%H:%M:%S"), inline = true}
					},
					footer = {text = "SAE Predictor"}
				}}
			})
	})
	end)
	pcall(function()
		http_request({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({
				content = "@everyone",
				embeds = {{
					title = "👑 "..rarity.." EGG DETECTED!",
					description = "**"..data.DisplayName.."** rarity spawned!",
					color = 16711935,
					fields = {
						{name = "Rate", value = data.DefaultRarityValue, inline = true},
						{name = "Time", value = os.date("%H:%M:%S"), inline = true}
					}
				}}
			})
		})
	end)
end

-- LOOP CEK CONFIG
task.spawn(function()
	local cd = 3
	while g.Parent do
		task.wait(1)
		cd = cd - 1
		timer.Text = "Check: "..cd.."s"
		
		if cd <= 0 then
			cd = 3
			local configs = RS:WaitForChild("Data"):WaitForChild("Rarity"):WaitForChild("Configs")
			
			for rarityName, _ in pairs(RareList) do
				local config = configs:FindFirstChild(rarityName)
				if config then
					local data = require(config)
					if not sent[rarityName] then -- biar ga spam
						sent[rarityName] = true
						last.Text = "Last: "..rarityName
						status.Text = "FOUND: "..rarityName
						SendWebhook(rarityName, data)
						task.wait(10) -- cooldown 10 detik biar ga spam webhook
						sent[rarityName] = nil -- reset biar bisa detect lagi nanti
					end
				end
			end
			if status.Text == "FOUND: "..last.Text then
				status.Text = "Status: Monitoring..."
			end
		end
	end
end)
