local function CreateSlider(name, yPos, min, max, default, callback)
	local container = Instance.new("Frame")
	container.Parent = Frame
	container.Size = UDim2.new(0, 300, 0, 36)
	container.Position = UDim2.new(0, 10, 0, yPos)
	container.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
	container.BorderSizePixel = 0

	local lbl = Instance.new("TextLabel")
	lbl.Parent = container
	lbl.Size = UDim2.new(1, -10, 0, 16)
	lbl.Position = UDim2.new(0, 5, 0, 2)
	lbl.BackgroundTransparency = 1
	lbl.Text = name .. ": " .. default
	lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
	lbl.Font = Enum.Font.SourceSans
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left

	local bar = Instance.new("Frame")
	bar.Parent = container
	bar.Size = UDim2.new(1, -10, 0, 8)
	bar.Position = UDim2.new(0, 5, 0, 22)
	bar.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	bar.BorderSizePixel = 0

	local fill = Instance.new("Frame")
	fill.Parent = bar
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
	fill.BorderSizePixel = 0

	local btn = Instance.new("TextButton")
	btn.Parent = bar
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""

	local dragging = false
	local function update(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local value = math.floor(min + (max - min) * rel)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		lbl.Text = name .. ": " .. value
		callback(value)
	end
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
end

