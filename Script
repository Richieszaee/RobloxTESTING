-- FUNCTIONS
local function TweenTo(pos)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return 0 end
	local dist = (hrp.Position - pos.Position).Magnitude
	local time = math.clamp(dist / TweenSpeed, 0.05, 2)
	TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = pos}):Play()
	return time
end

local function GetRarityValue(obj)
	local rarity = obj:GetAttribute("Rarity") or obj:GetAttribute("rarity") or "Common"
	return RARITY_ORDER[rarity] or 1, rarity
end

local function FindBestEgg()
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	
	local bestEgg, bestScore, bestDist = nil, 0, math.huge
	for _,v in pairs(Workspace:GetDescendants()) do
		if v:IsA("Model") and v.Name:lower():find("egg") then
			local part = v:FindFirstChildWhichIsA("BasePart", true)
			if part then
				local score, rarityName = GetRarityValue(v)
				local dist = (hrp.Position - part.Position).Magnitude
				-- Prioritas: Rarity tinggi > Jarak dekat
				if score > bestScore or (score == bestScore and dist < bestDist) then
					bestEgg = part
					bestScore = score
					bestDist = dist
				end
			end
		end
	end
	return bestEgg
end

-- LOOP
task.spawn(function()
	while true do task.wait(0.1)
		if AutoSteal then
			local egg = FindBestEgg()
			if egg then
				local t1 = TweenTo(egg)
				task.wait(t1 + 0.1)
				if InteractRemote then InteractRemote:FireServer(egg) end
				task.wait(0.2)
				if BasePoint then
					local t2 = TweenTo(BasePoint)
					task.wait(t2 + 0.2)
				end
			end
		end
	end
end)

