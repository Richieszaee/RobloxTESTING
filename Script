-- StarterPlayerScripts > EggESP
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local ESP_ON = true

-- WARNA PER RARITY
local RarityColors = {
	["Common"] = Color3.fromRGB(170, 170, 170), -- Abu
	["Uncommon"] = Color3.fromRGB(0, 170, 0), -- Hijau
	["Rare"] = Color3.fromRGB(0, 120, 255), -- Biru
	["Epic"] = Color3.fromRGB(170, 0, 255), -- Ungu
	["Legendary"] = Color3.fromRGB(255, 170, 0), -- Orange
	["Mythic"] = Color3.fromRGB(255, 0, 170), -- Pink
	["Cosmic"] = Color3.fromRGB(0, 255, 255), -- Cyan
	["Secret"] = Color3.fromRGB(255, 255, 0), -- Kuning
	["Eternal"] = Color3.fromRGB(255, 0, 0), -- Merah
	["Divine"] = Color3.fromRGB(255, 255, 255) -- Putih/Pelangi nanti
}

local ESP_Objects = {}

local function ClearESP(obj)
	if ESP_Objects[obj] then
		for _,v in pairs(ESP_Objects[obj]) do v:Destroy() end
	ESP_Objects[obj] = nil
	end
end

local function CreateESP(egg, rarity)
	ClearESP(egg)
	if not egg:FindFirstChild("HumanoidRootPart") and not egg:IsA("BasePart") then return end
	
	local part = egg:IsA("BasePart") and egg or egg:FindFirstChildWhichIsA("BasePart", true)
	if not part then return end
	
	local color = RarityColors[rarity] or Color3.new(1,1,1)
	
	-- HIGHLIGHT
	local highlight = Instance.new("Highlight")
	highlight.Name = "EggESP"
	highlight.FillColor = color
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0
	highlight.Parent = egg
	highlight.Adornee = egg
	
	-- BILLBOARD
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EggESPText"
	billboard.Size = UDim2.new(0, 120, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = egg
	
	local label = Instance.new("TextLabel", billboard)
	label.Size = UDim2.new(1,0,1,0)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.new(0,0,0)
	label.TextColor3 = color
	label.Text = rarity.."\nEgg"
	
	ESP_Objects[egg] = {highlight, billboard}
end

