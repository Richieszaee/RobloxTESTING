-- GRADIENT PELANGI
local gradient = Instance.new("UIGradient", Main)
gradient.Color = ColorSequence.new{
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 180, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 180, 255))
