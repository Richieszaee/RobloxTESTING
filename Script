--// TWEEN FUNCTION
local function getHRP()
	local char = LP.Character
	if not char then return nil, nil end
	return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
end

local function tweenTo(targetPos, speed)
	local hrp, hum = getHRP()
	if not hrp or not hum then return false end

	local distance = (hrp.Position - targetPos).Magnitude
	local duration = distance / (speed or 250)

	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.PlatformStand = true
	hrp.Anchored = true

	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{CFrame = CFrame.new(targetPos)}
	)
	tween:Play()
	tween.Completed:Wait()

	hrp.Anchored = false
	hum.PlatformStand = false
	hum.WalkSpeed = 16
	hum.JumpPower = 50
	return true
end

--// EGG FINDER
-- Cari object yang namanya mengandung "Egg" di workspace
local function findEggs()
	local eggs = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Model") then
			local name = obj.Name
			if name:lower():find("egg") and not name:lower():find("gui") then
				local pos
				if obj:IsA("Model") then
					local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
					if primary then pos = primary.Position end
				else
					pos = obj.Position
				end
				if pos then
					table.insert(eggs, {object = obj, position = pos, name = name})
				end
			end
		end
	end
	return eggs
end

-- Cari biome terdekat dari posisi player
local function detectBiome(pos)
	local closest = "Unknown"
	local minDist = math.huge
	for _, biomeName in ipairs(BIOMES) do
		if biomeName ~= "All" then
			local biomeObj = workspace:FindFirstChild(biomeName, true)
			if biomeObj then
				local bPos
				if biomeObj:IsA("Model") then
					local pp = biomeObj.PrimaryPart or biomeObj:FindFirstChildWhichIsA("BasePart")
					if pp then bPos = pp.Position end
				elseif biomeObj:IsA("BasePart") then
					bPos = biomeObj.Position
				end
				if bPos then
					local d = (pos - bPos).Magnitude
					if d < minDist then minDist = d; closest = biomeName end
				end
			end
		end
	end
	return closest
end

--// STEAL LOGIC
local function stealEgg(egg)
	local hrp, hum = getHRP()
	if not hrp then return false end

	-- Tween ke egg
	addLog("🎯 Menuju: " .. egg.name, Color3.fromRGB(255, 200, 0))
	local ok = tweenTo(egg.position, getgenv().TweenSpeed)
	if not ok then return false end

	-- Cek jarak
	local dist = (hrp.Position - egg.position).Magnitude
	if dist > getgenv().StealRange then
		addLog("❌ Terlalu jauh dari egg", Color3.fromRGB(255, 80, 80))
		return false
	end

	-- Auto interact: kirim E / ProximityPrompt
	if getgenv().AutoInteract then
		-- Trigger ProximityPrompt kalau ada
		for _, d in ipairs(egg.object:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				pcall(function()
					game:GetService("ProximityPromptService"):PromptButtonHoldBegan(d)
					task.wait(0.3)
					game:GetService("ProximityPromptService"):PromptButtonHoldEnded(d)
				end)
			end
		end

		-- Kirim E key via VirtualInputManager (kalau ProximityPrompt ga ada)
		local VIM = game:GetService("VirtualInputManager")
		pcall(function()
			VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
			task.wait(0.15)
			VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)
	end

	addLog("✅ Berhasil interact dengan " .. egg.name, Color3.fromRGB(0, 255, 100))
	return true
end

--// AUTO STEAL LOOP
task.spawn(function()
	while task.wait(0.5) do
		if not ScreenGui.Parent then break end
		if not getgenv().AutoSteal then continue end

		local hrp = getHRP()
		if not hrp then continue end

		-- Cari egg
		local eggs = findEggs()
		if #eggs == 0 then
			setStatus("🔍 Mencari egg...", Color3.fromRGB(255, 200, 0))
			continue
		end

		-- Filter berdasarkan biome
		local targetEgg = nil
		local minDist = math.huge
		for _, egg in ipairs(eggs) do
			local biome = detectBiome(egg.position)
			if getgenv().SelectedBiome == "All" or biome == getgenv().SelectedBiome then
				local d = (hrp.Position - egg.position).Magnitude
				if d < minDist then
					minDist = d
					targetEgg = egg
				end
			end
		end

		if not targetEgg then
			setStatus("⚠️ Nggak ada egg di biome " .. getgenv().SelectedBiome, Color3.fromRGB(255, 200, 0))
			continue
		end

		-- Steal
		setStatus("🎯 Target: " .. targetEgg.name .. " (" .. math.floor(minDist) .. " studs)", Color3.fromRGB(0, 200, 255))
		stealEgg(targetEgg)

		task.wait(0.5)
	end
end)

